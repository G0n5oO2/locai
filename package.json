{
  "name": "locai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:env": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "postinstall": "prisma generate",
    "seed:users": "node scripts/seed-users.mjs",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "test:concurrency": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx tests/concurrency.mts",
    "test:flow": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx tests/order-flow.mts",
    "seed:leftover": "node --env-file-if-exists=.env.local scripts/seed-leftover.mjs",
    "test:messages": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx tests/messages.mts",
    "try:ai": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx tests/ai-try.mts",
    "test:payment": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx tests/payment.mts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
