// 表の設計図（スキーマ）
// 接続先は prisma.config.ts に書いてある

generator client {
  provider = "prisma-client"
  // 型付きの部品（Prisma Client）を作る場所
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== ログイン（Better Auth が使う表） =====

// 利用者の立場。登録のときに選び、あとから変えられない
enum Role {
  producer // 生産者
  buyer // 飲食店
}

// 利用者
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       ProducerProfile?

  @@map("user")
}

// ログイン中の状態（どのブラウザで、いつまでログインしているか）
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// ログインの方法（メールアドレスとパスワードなど）。パスワードはそのままではなく、変換して保存される
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// メールアドレスの確認などに使う、一時的な値
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===== 生産者 =====

// 生産者プロフィール（生産者1人につき1つ）
// 写真はあとで足す（飲食店が「どんな人か」分かるようにするため）
model ProducerProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 畑の地域（市区町村）。「近い地域」の判断に使う
  prefecture        String
  city              String
  // 栽培している品目（例：賀茂茄子、万願寺唐辛子）
  items             String
  // 栽培のこだわり
  commitment        String
  // 1回の出荷で何件まで対応できるか（受け渡し方法ごと）
  shipLimitDelivery Int // 宅配発送
  shipLimitSelf     Int // 自分で配達
  shipLimitPickup   Int // 引き取り
  // お試しの量（g）。まだ買ったことがないお店が、1回だけこの量で買える
  trialAmountG      Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("producer_profile")
}
