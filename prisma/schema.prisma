// 表の設計図（スキーマ）
// 接続先は prisma.config.ts に書いてある

generator client {
  provider = "prisma-client"
  // 型付きの部品（Prisma Client）を作る場所
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== ログイン（Better Auth が使う表） =====

// 利用者の立場。登録のときに選び、あとから変えられない
enum Role {
  producer // 生産者
  buyer // 飲食店
}

// 利用者
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       ProducerProfile?
  buyerProfile  BuyerProfile?
  listings      Listing[]

  @@map("user")
}

// ログイン中の状態（どのブラウザで、いつまでログインしているか）
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// ログインの方法（メールアドレスとパスワードなど）。パスワードはそのままではなく、変換して保存される
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// メールアドレスの確認などに使う、一時的な値
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===== 生産者 =====

// 生産者プロフィール（生産者1人につき1つ）
// 写真はあとで足す（飲食店が「どんな人か」分かるようにするため）
model ProducerProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 畑の地域（市区町村）。「近い地域」の判断に使う
  prefecture        String
  city              String
  // 栽培している品目（例：賀茂茄子、万願寺唐辛子）
  items             String
  // 栽培のこだわり
  commitment        String
  // 1回の出荷で何件まで対応できるか（受け渡し方法ごと）
  shipLimitDelivery Int // 宅配発送
  shipLimitSelf     Int // 自分で配達
  shipLimitPickup   Int // 引き取り
  // お試しの量（g）。まだ買ったことがないお店が、1回だけこの量で買える
  trialAmountG      Int
  // 宅配発送の送料（数量帯別、3行まで）。「◯g まで ◯円」。宅配をしない人は空のまま
  deliveryBand1MaxG Int?
  deliveryBand1Yen  Int?
  deliveryBand2MaxG Int?
  deliveryBand2Yen  Int?
  deliveryBand3MaxG Int?
  deliveryBand3Yen  Int?
  // 自分で配達するときの料金（1件あたり）。配達をしない人は空のまま
  selfDeliveryYen   Int?
  // 引き取りの場所。販売確定した相手にだけ見せる（不変条件4）
  pickupPlace       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("producer_profile")
}

// 品の状態
enum Quality {
  normal // 通常品
  irregular // 規格外
}

// 出品の状態
enum ListingStatus {
  open // 受付中
  closed // 受付終了
}

// 出品
// 量はすべて g の整数、金額は円の整数（小数で計算しない）
model Listing {
  id             String        @id @default(cuid())
  producerId     String
  producer       User          @relation(fields: [producerId], references: [id], onDelete: Cascade)
  // 食材名
  vegetable      String
  // 販売可能総量・注文単位・最低注文量（g）
  totalG         Int
  unitG          Int
  minOrderG      Int
  // 単価（注文単位あたりの円）
  unitPriceYen   Int
  // 品の状態・余剰品かどうか・伝えたいこと
  quality        Quality
  surplus        Boolean
  note           String        @default("")
  // 受付期限・回答期限
  acceptUntil    DateTime
  answerUntil    DateTime
  // 納品できる日（いつから・いつまで）
  deliverFrom    DateTime      @db.Date
  deliverTo      DateTime      @db.Date
  // 対応する受け渡し方法
  offersDelivery Boolean // 宅配発送
  offersSelf     Boolean // 自分で配達
  offersPickup   Boolean // 引き取り
  status         ListingStatus @default(open)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([producerId])
  @@index([status, acceptUntil])
  @@map("listing")
}

// ===== 飲食店 =====

// 飲食店プロフィール（飲食店1つにつき1つ）
model BuyerProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // お店の地域（市区町村）。「近い地域」の判断に使う
  prefecture String
  city       String
  // 届け先の住所。販売確定した相手の生産者にだけ見せる（不変条件4）
  address    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("buyer_profile")
}
