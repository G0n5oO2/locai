// 表の設計図（スキーマ）
// 接続先は prisma.config.ts に書いてある

generator client {
  provider = "prisma-client"
  // 型付きの部品（Prisma Client）を作る場所
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== ログイン（Better Auth が使う表） =====

// 利用者の立場。登録のときに選び、あとから変えられない
enum Role {
  producer // 生産者
  buyer // 飲食店
}

// 利用者
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       ProducerProfile?
  buyerProfile  BuyerProfile?
  listings      Listing[]
  orders        Order[]
  exposure      ProducerExposure?
  wanted        WantedRequest[]
  notices       ListingNotice[]
  messages      OrderMessage[]

  @@map("user")
}

// ログイン中の状態（どのブラウザで、いつまでログインしているか）
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// ログインの方法（メールアドレスとパスワードなど）。パスワードはそのままではなく、変換して保存される
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// メールアドレスの確認などに使う、一時的な値
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===== 生産者 =====

// 生産者プロフィール（生産者1人につき1つ）
// 写真はあとで足す（飲食店が「どんな人か」分かるようにするため）
model ProducerProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 畑の地域（市区町村）。「近い地域」の判断に使う
  prefecture        String
  city              String
  // 栽培している品目（例：賀茂茄子、万願寺唐辛子）
  items             String
  // 栽培のこだわり
  commitment        String
  // 1回の出荷で何件まで対応できるか（受け渡し方法ごと）
  shipLimitDelivery Int // 宅配発送
  shipLimitSelf     Int // 自分で配達
  shipLimitPickup   Int // 引き取り
  // お試しの量（g）。第1版のお試しで使っていたもの。第2版のお試し食材に置き換えたので、今は使わない
  trialAmountG      Int      @default(500)
  // 宅配発送の送料（数量帯別、3行まで）。「◯g まで ◯円」。宅配をしない人は空のまま
  deliveryBand1MaxG Int?
  deliveryBand1Yen  Int?
  deliveryBand2MaxG Int?
  deliveryBand2Yen  Int?
  deliveryBand3MaxG Int?
  deliveryBand3Yen  Int?
  // 自分で配達するときの料金（1件あたり）。配達をしない人は空のまま
  selfDeliveryYen   Int?
  // 引き取りの場所。販売確定した相手にだけ見せる（不変条件4）
  pickupPlace       String?
  // 受け付ける支払方法（第2版）。支払い自体はアプリの外で行う。空なら「メッセージで相談」
  paymentMethods    PaymentMethod[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("producer_profile")
}

// 支払方法（第2版）。支払い自体はアプリの外で行い、どう払うかを伝えるために使う
enum PaymentMethod {
  cash // 現金（農家さん本人に渡す）
  transfer // 振り込み
  cod // 代金引換（宅配のときだけ）
  mobile // スマホ決済
}

// 品の状態
enum Quality {
  normal // 通常品
  irregular // 規格外
}

// 出品の状態
enum ListingStatus {
  open // 受付中
  closed // 受付終了
}

// 出品
// 量はすべて g の整数、金額は円の整数（小数で計算しない）
model Listing {
  id             String        @id @default(cuid())
  producerId     String
  producer       User          @relation(fields: [producerId], references: [id], onDelete: Cascade)
  // 食材名
  vegetable      String
  // 販売可能総量・注文単位・最低注文量（g）
  totalG         Int
  unitG          Int
  minOrderG      Int
  // 単価（注文単位あたりの円）
  unitPriceYen   Int
  // 品の状態・余剰品かどうか・伝えたいこと
  quality        Quality
  surplus        Boolean
  note           String        @default("")
  // 受付期限・回答期限
  acceptUntil    DateTime
  answerUntil    DateTime
  // 納品できる日（いつから・いつまで）
  deliverFrom    DateTime      @db.Date
  deliverTo      DateTime      @db.Date
  // 対応する受け渡し方法
  offersDelivery Boolean // 宅配発送
  offersSelf     Boolean // 自分で配達
  offersPickup   Boolean // 引き取り
  status         ListingStatus @default(open)
  // お試し食材か（第2版）。お試し食材は、お試しのタブにだけ出す（ふつうの検索・出品一覧には出さない）
  isTrial        Boolean       @default(false)
  // お試し食材の回答期限：申し込みから何日以内に返事をするか（1〜3日。ふつうの出品では空）
  trialAnswerDays Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orders         Order[]
  notices        ListingNotice[]

  @@index([producerId])
  @@index([status, acceptUntil])
  @@map("listing")
}

// ===== 飲食店 =====

// 飲食店プロフィール（飲食店1つにつき1つ）
model BuyerProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // お店の地域（市区町村）。「近い地域」の判断に使う
  prefecture String
  city       String
  // 届け先の住所。販売確定した相手の生産者にだけ見せる（不変条件4）
  address    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("buyer_profile")
}

// ===== 注文（購入希望） =====

// 注文の状態（docs/04_producer_design.md 4章の状態遷移）
enum OrderStatus {
  pending // 回答待ち
  change_pending // 条件変更の確認待ち
  confirmed // 販売確定
  declined // 見送り
  cancelled // 取消
  expired // 期限切れ
}

// 受け渡し方法
enum DeliveryMethod {
  delivery // 宅配発送
  self // 自分で配達
  pickup // 引き取り
}

// 注文（購入希望）
// 単価・送料・金額は、申し込んだときの値を写して保存する（あとで出品やプロフィールを変えても、この注文の金額は変わらない）
model Order {
  id           String         @id @default(cuid())
  listingId    String
  listing      Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  // 量（g）と受け渡し
  quantityG    Int
  method       DeliveryMethod
  deliveryDate DateTime       @db.Date // 納品日
  useDate      DateTime       @db.Date // 使用日（お店が料理に使う日）
  showUseDate  Boolean // 使用日を生産者に見せてよいか（お店が選ぶ）
  // 申し込んだときの単価と金額（円）
  unitG        Int
  unitPriceYen Int
  itemYen      Int // 商品代
  shippingYen  Int // 送料・配達料
  totalYen     Int // 合計
  isTrial      Boolean        @default(false) // お試しの申し込みか
  // お店が選んだ支払方法（第2版）。農家さんが設定していないときは空（メッセージで相談）
  paymentMethod PaymentMethod?
  status       OrderStatus    @default(pending)
  answerUntil  DateTime // 回答期限
  // 生産者からの条件変更の提案（条件変更の確認待ちのときだけ使う）
  proposedDeliveryDate DateTime? @db.Date
  proposedQuantityG    Int?
  proposedItemYen      Int?
  proposedShippingYen  Int?
  proposedTotalYen     Int?
  // 断られたときに「元の条件で確定」するか（false なら見送り）
  confirmIfRefused     Boolean?
  // 納品日をずらす提案をしたか（「ずらされた回数が少ないお店から」提案するために数える）
  dateChangeProposed   Boolean        @default(false)
  // 同じ申し込みを二重に送らないための目印（送信ボタンの連打対策）
  requestKey   String         @unique
  // メッセージを最後に読んだ時刻（未読の数を出すため）
  buyerReadAt    DateTime?
  producerReadAt DateTime?
  messages       OrderMessage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([listingId, status])
  @@index([buyerId])
  @@map("order")
}

// 農家さんごとの、検索結果に表示された回数（不変条件6：公平に並べる）
model ProducerExposure {
  producerId String   @id
  producer   User     @relation(fields: [producerId], references: [id], onDelete: Cascade)
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("producer_exposure")
}

// ===== 探しています =====

// 食材の種類
enum WantedKind {
  specified // 指定する
  substitute // 代替野菜も可
  any // 種類を問わない
}

// お店の「探しています」
// 農家さんに見せるのは、地域・食材・希望数量・使用日・受け取り方法だけ（店名・住所は見せない）
// 予算は、見えると値段がそれに引っ張られるので、そもそも保存しない
model WantedRequest {
  id          String         @id @default(cuid())
  buyerId     String
  buyer       User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  kind        WantedKind
  // 探している食材（種類を問わないときは空）
  vegetable   String         @default("")
  // 代替野菜も可のとき、お店が「これならOK」と選んだ野菜
  substitutes String[]       @default([])
  quantityG   Int
  useDate     DateTime       @db.Date
  method      DeliveryMethod
  // お店の地域（公開したときのもの）
  prefecture  String
  city        String
  closed      Boolean        @default(false) // お店が取り下げたら true
  createdAt   DateTime       @default(now())

  @@index([closed, useDate])
  @@map("wanted_request")
}

// 売れ残りを「探しているお店」に知らせた記録（同じ出品・同じお店には1回だけ）
model ListingNotice {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@map("listing_notice")
}

// 注文ごとのメッセージ（見られるのは、その注文のお店と農家さんだけ：不変条件4）
model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_message")
}
