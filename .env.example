# 環境変数の見本（値は入れない）
# このファイルをコピーして .env.local を作り、= のあとに自分の値を書く。
# .env.local は GitHub に送られない（.gitignore で除外している）。

# Neon のプーリング経由の接続文字列（ステップ6の Vercel 連携で自動登録される）
DATABASE_URL=

# Neon の直接接続の接続文字列（Prisma のマイグレーション用。同上）
DATABASE_URL_UNPOOLED=

# Google AI Studio で作った API キー（サーバー側だけで使う）
GEMINI_API_KEY=

# AI Studio で確認したモデル名
GEMINI_MODEL=

# ログインの仕組み（Better Auth）が使う秘密の文字列（32文字以上のランダムな文字列）
# 作り方：ターミナルで openssl rand -base64 32 を実行し、出てきた文字列を貼る
BETTER_AUTH_SECRET=
